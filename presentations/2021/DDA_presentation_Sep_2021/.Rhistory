one_d_fun <- function(x) {
y <- (1-1/2*((sin(12*x)/(1+x))+(2*cos(7*x)*x^5)+0.7))
return(y)
}
xmin <- optimize(one_d_fun, c(0, 1), tol = 0.0001, maximum = TRUE)
