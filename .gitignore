# Existing rules
/.quarto/
.Rproj.user

# LaTeX-generated intermediate and auxiliary files
*.aux
*.bbl
*.blg
*.brf
*.fls
*.fdb_latexmk
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.toc
*.synctex.gz
